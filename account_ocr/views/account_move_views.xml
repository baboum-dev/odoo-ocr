<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_account_ocr" model="ir.ui.view">
        <field name="name">account.move.form.account.ocr</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_process_main_attachment_ocr"
                    string="Run OCR"
                    type="object"
                    class="oe_highlight"
                    invisible="move_type != 'in_invoice' or state != 'draft'"
                />
            </xpath>
        </field>
    </record>
</odoo>
